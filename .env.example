DATABENTO_API_KEY=db-your-api-key-here
MCP_PORT=8008

# Fixes an unbounded RSS leak found 2026-08-24: FastMCP's default stateful
# streamable-HTTP mode never expires sessions, so every request without a
# reused Mcp-Session-Id leaks ~60KB permanently (2.78GB over 16 days on this
# server before it was caught). No cross-request session state is needed here.
FASTMCP_STATELESS_HTTP=true
